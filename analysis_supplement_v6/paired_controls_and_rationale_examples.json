  "rationale_examples": [
    {
      "instance_id": "django__django-11555",
      "packet_id": "pk_6f306de8e45c",
      "verdict_file": "historical_analysis/data/llm_reviews/verified/reviewer-claude-frontier/pk_6f306de8e45c.json",
      "verdict_sha256": "e4affeef53c880c93230d99b0c1013fc5869f2b8a429c5cc444863f2a3959a15",
      "summary": "The patch stops the crash for the trivial ascending-F case but is the wrong fix: it coerces an OrderBy into `field.expression.name`, discarding the OrderBy's direction and expression semantics, and breaks on expressions without a `.name`. The proper fix preserves the OrderBy object in `find_ordering_name` rather than flattening it to a string in `get_order_dir`.",
      "issues": [
        {
          "failure_mode": "F8",
          "severity": "blocking",
          "description": "Fix is at the wrong layer and loses information. `get_order_dir` is forced to return a plain field name + default direction, so an OrderBy like `F('x').desc()` is reduced to ('x', 'ASC') — the descending flag and any non-trivial expression behavior are silently dropped. The correct approach (the one Django merged) intercepts the item in `find_ordering_name`/`get_order_by` and keeps it as an OrderBy object instead of stringifying it."
        },
        {
          "failure_mode": "F1",
          "severity": "blocking",
          "description": "Incomplete: `field.expression.name` assumes the wrapped expression has a `.name` attribute. For `Meta.ordering` entries such as `Lower('name').asc()`, `Coalesce(...)`, or any Func/Combined expression, `.expression` has no `.name`, so this raises AttributeError — a new crash for the broader class of the very bug being fixed."
        },
        {
          "failure_mode": "F3",
          "severity": "major",
          "description": "Passes only because the reproduction case uses an ascending F-expression, where coercing to the bare field name happens to yield equivalent SQL. The change is special-cased to that scenario rather than being a general resolution of expression ordering."
        },
        {
          "failure_mode": "F6",
          "severity": "minor",
          "description": "`hasattr(field, 'expression')` is loose duck-typing; Django idiom here would use `isinstance(field, OrderBy)` (or check `resolve_expression`) and would not reuse the low-level `get_order_dir` string helper for this purpose."
        }
      ]
    },
    {
      "instance_id": "django__django-12155",
      "packet_id": "pk_d8856beb1f80",
      "verdict_file": "historical_analysis/data/llm_reviews/verified/reviewer-claude-frontier/pk_d8856beb1f80.json",
      "verdict_sha256": "d561190cdf816a5cc5cc2e0bb590624869420bedb53409e0c121b12118ddeedd",
      "summary": "Fix correctly resolves the reported multi-line case by skipping the first line's zero indent, but omits the `default=0` guard, so `min()` now runs over an empty sequence for single-line docstrings and raises `ValueError: min() arg is an empty sequence`. This is a real regression on a very common docstring form.",
      "issues": [
        {
          "failure_mode": "F2",
          "severity": "blocking",
          "description": "For a single-line docstring (e.g. `\"\"\"Test something.\"\"\"`), `lines[1:]` is empty, so the generator yields nothing and `min(...)` raises `ValueError: min() arg is an empty sequence`. Previously this worked (indent=0). The correct fix needs `default=0`: `min((... for line in lines[1:] if line.lstrip()), default=0)`."
        },
        {
          "failure_mode": "F1",
          "severity": "major",
          "description": "Incomplete fix: also crashes when all subsequent lines are blank/whitespace-only (empty filtered generator), same empty-sequence ValueError. Both cases collapse to the missing `default=0`."
        }
      ]
    }
